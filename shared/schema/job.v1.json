{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfectvoice.local/schema/job.v1.json",
  "title": "PerfectVoice job result v1",
  "description": "Engine → panel / job.json. handles_*_actual and wet_dry_sample_rate are required here. wet_dry_sample_rate is engine-derived (44100 if enhancer=none, 48000 if deepfilternet3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "created_at",
    "engine_version",
    "params",
    "clips"
  ],
  "properties": {
    "schema": {
      "const": "perfectvoice.job.v1"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 / RFC 3339"
    },
    "engine_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Engine semver (also hashed as engine_semver)."
    },
    "params": {
      "$ref": "https://perfectvoice.local/schema/params.v1.json"
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/clip_result"
      }
    }
  },
  "$defs": {
    "clip_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clip_id",
        "input_hash",
        "output_path",
        "output_samples",
        "handles_left_actual",
        "handles_right_actual",
        "wet_dry_sample_rate",
        "peak",
        "cache_hit"
      ],
      "properties": {
        "clip_id": {
          "type": "string",
          "format": "uuid"
        },
        "input_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 hex of the identity fields in hash-fields.v1.json"
        },
        "output_path": {
          "type": "string",
          "minLength": 1
        },
        "output_samples": {
          "type": "integer",
          "minimum": 0
        },
        "handles_left_actual": {
          "type": "number",
          "minimum": 0,
          "description": "min(H, max(0, t0)). Panel place MUST use this, not handles_seconds."
        },
        "handles_right_actual": {
          "type": "number",
          "minimum": 0,
          "description": "min(H, max(0, file_duration − t1)). Panel place MUST use this, not handles_seconds."
        },
        "wet_dry_sample_rate": {
          "type": "integer",
          "enum": [44100, 48000],
          "description": "Engine-derived only. 44100 if enhancer=none, 48000 if deepfilternet3."
        },
        "peak": {
          "type": "number",
          "minimum": 0
        },
        "cache_hit": {
          "type": "boolean"
        }
      }
    }
  }
}
